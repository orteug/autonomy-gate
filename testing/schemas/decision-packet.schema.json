{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-packet.schema.json",
  "title": "Autonomy Decision Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "packet_version",
    "autonomy",
    "assessment_surface",
    "execution_architecture",
    "builder_surface",
    "confidence",
    "terminal_action",
    "justification",
    "controls_required",
    "evidence_gaps",
    "artifact_required",
    "handoff_status",
    "operator_disposition"
  ],
  "properties": {
    "workflow_id": {"type": "string", "pattern": "^WF-\\d{8}-\\d{3}$"},
    "packet_version": {"type": "string", "pattern": "^v\\d+$"},
    "autonomy": {"enum": ["AUTONOMOUS", "SUPERVISED", "SOP_FIRST", "HUMAN_ONLY"]},
    "assessment_surface": {"type": "string", "minLength": 3},
    "execution_architecture": {"type": "string", "minLength": 10},
    "builder_surface": {"type": "string", "minLength": 3},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "terminal_action": {"type": "string", "minLength": 10},
    "justification": {"type": "string", "pattern": "RULE-\\d+"},
    "controls_required": {"type": "array", "items": {"type": "string", "minLength": 5}},
    "evidence_gaps": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "artifact_required": {"type": "string", "minLength": 3},
    "architecture_selected": {"type": "boolean"},
    "handoff_status": {"enum": ["BUILD_READY", "BLOCKED_FOR_EVIDENCE", "NOT_APPLICABLE"]},
    "operator_disposition": {"enum": ["PENDING", "APPROVE_FOR_BUILD", "REVISE", "HOLD_FOR_EVIDENCE", "REJECT"]},
    "disposition_by": {"type": "string", "minLength": 2},
    "disposition_date": {"type": "string", "format": "date"},
    "disposition_rationale": {"type": "string", "minLength": 5}
  },
  "allOf": [
    {
      "if": {"properties": {"confidence": {"const": "HIGH"}}, "required": ["confidence"]},
      "then": {"properties": {"evidence_gaps": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"confidence": {"enum": ["MEDIUM", "LOW"]}}, "required": ["confidence"]},
      "then": {"properties": {"evidence_gaps": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"handoff_status": {"const": "BUILD_READY"}}, "required": ["handoff_status"]},
      "then": {"properties": {"architecture_selected": {"const": true}}, "required": ["architecture_selected"]}
    },
    {
      "if": {"properties": {"operator_disposition": {"const": "APPROVE_FOR_BUILD"}}, "required": ["operator_disposition"]},
      "then": {"required": ["disposition_by", "disposition_date", "disposition_rationale"], "properties": {"handoff_status": {"const": "BUILD_READY"}}}
    },
    {
      "if": {"properties": {"autonomy": {"const": "HUMAN_ONLY"}}, "required": ["autonomy"]},
      "then": {"properties": {"handoff_status": {"const": "NOT_APPLICABLE"}}}
    }
  ]
}
