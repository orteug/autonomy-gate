{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-architecture.schema.json",
  "title": "Workflow Architecture Selection",
  "type": "object",
  "required": ["workflow_id", "packet_version", "options", "selected_option_id", "selection_by", "selection_date"],
  "properties": {
    "workflow_id": {"type": "string", "pattern": "^WF-\\d{8}-\\d{3}$"},
    "packet_version": {"type": "string", "pattern": "^v\\d+$"},
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "class", "execution_architecture", "builder_surface", "control_fit", "implementation_effort", "operating_cost", "maintenance_burden", "security_fit", "portability", "skill_requirements", "source_evidence"],
        "properties": {
          "id": {"type": "string"},
          "class": {"enum": ["PRIMARY", "NATIVE_SUITE", "LOW_CODE", "CODE_FIRST", "VENDOR_NEUTRAL"]},
          "execution_architecture": {"type": "string", "minLength": 10},
          "builder_surface": {"type": "string", "minLength": 3},
          "control_fit": {"type": "string"},
          "implementation_effort": {"type": "string"},
          "operating_cost": {"type": "string"},
          "maintenance_burden": {"type": "string"},
          "security_fit": {"type": "string"},
          "portability": {"type": "string"},
          "skill_requirements": {"type": "string"},
          "source_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "omitted_classes": {"type": "array", "items": {"type": "object", "required": ["class", "reason"]}},
    "selected_option_id": {"type": "string", "minLength": 1},
    "selection_by": {"type": "string", "minLength": 2},
    "selection_date": {"type": "string", "format": "date"}
  }
}
