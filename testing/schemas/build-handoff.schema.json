{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "build-handoff.schema.json",
  "title": "Build Handoff Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "packet_version", "status", "terminal_action_boundary", "architecture_decision_record", "permissions_credentials_contract", "deterministic_controls", "human_checkpoints", "prohibited_actions", "logging_audit_requirements", "failure_rollback_stop_behavior", "acceptance_tests", "deployment_sequence", "assumptions", "unresolved_dependencies", "expiration_triggers", "version_invalidation_triggers", "tool_alternatives", "builder_acknowledgement", "stop_conditions"],
  "properties": {
    "workflow_id": {"type": "string", "pattern": "^WF-\\d{8}-\\d{3}$"},
    "packet_version": {"type": "string", "pattern": "^v\\d+$"},
    "status": {"enum": ["BUILD_READY", "BLOCKED_FOR_EVIDENCE", "NOT_APPLICABLE"]},
    "architecture_option_id": {"type": "string", "minLength": 2},
    "terminal_action_boundary": {"type": "string", "minLength": 5},
    "architecture_decision_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_option_id", "selected_by", "selection_date", "rejected_or_omitted_options"],
      "properties": {
        "selected_option_id": {"type": "string", "minLength": 2},
        "selected_by": {"type": "string", "minLength": 2},
        "selection_date": {"type": "string", "minLength": 8},
        "rejected_or_omitted_options": {"type": "array", "items": {"type": "string", "minLength": 3}}
      }
    },
    "manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose", "complete_content", "source_evidence"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 3},
          "complete_content": {"type": "string", "minLength": 10},
          "source_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unresolved_dependencies": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "permissions_credentials_contract": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "deterministic_controls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "human_checkpoints": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "prohibited_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "logging_audit_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "failure_rollback_stop_behavior": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "acceptance_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["setup", "input", "expected", "pass_criterion"],
        "properties": {
          "setup": {"type": "string", "minLength": 3},
          "input": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 3},
          "pass_criterion": {"type": "string", "minLength": 3}
        }
      }
    },
    "deployment_sequence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "expiration_triggers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "version_invalidation_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "tool_alternatives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "builder_acknowledgement": {"type": "string", "minLength": 5},
    "human_operating_procedure": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "safe_decomposition_opportunities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "BUILD_READY"}}, "required": ["status"]},
      "then": {"required": ["architecture_option_id", "manifest"], "properties": {"manifest": {"minItems": 1}, "unresolved_dependencies": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"const": "BLOCKED_FOR_EVIDENCE"}}, "required": ["status"]},
      "then": {"required": ["unresolved_dependencies"], "properties": {"unresolved_dependencies": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "NOT_APPLICABLE"}}, "required": ["status"]},
      "then": {"required": ["human_operating_procedure", "safe_decomposition_opportunities"], "properties": {"manifest": {"maxItems": 0}}}
    }
  ]
}
