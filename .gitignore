# ============================================================
# THE AUTONOMY GATE — staging repo .gitignore
# This repo is the public release package.
# Only autonomy-gate/, adapters/, docs/, print-manual/
# output PDFs, and root docs belong here.
# ============================================================

# ── Python build artifacts ───────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Print manual — internal build files ─────────────────────
print-manual/proofs/
print-manual/__pycache__/
print-manual/CODEX_PRINT_MANUAL_IMAGE_PLAN.md

# ── Test infrastructure ─────────────────────────────────────
testing/

# ── Internal working folders (should never be here) ─────────
_build/
_strategy/
_marketing/

# ── Internal ops and session files ──────────────────────────
SESSION_LOG.md
CLAUDE_CALIBRATION_RESULTS_*.md
OPENAI_PLATFORM_TEST_RESULTS_*.md
production-assets/

# ── macOS system files ───────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Editor and IDE artifacts ─────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Environment and secrets ──────────────────────────────────
.env
.env.*
*.key
*.pem

# ── OS and tool noise ────────────────────────────────────────
Thumbs.db
desktop.ini
