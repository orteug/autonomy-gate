{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-record.schema.json",
  "title": "Workflow Governance Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_id", "name", "owner", "packet_version", "autonomy", "assessment_surface", "execution_architecture", "builder_surface", "confidence", "handoff_status", "disposition", "status", "assessed_date", "request_record", "architecture_options", "validation_evidence", "lifecycle_events", "incidents", "appeals", "change_assessments", "precedent_refs", "value_metrics"],
  "properties": {
    "workflow_id": {"type": "string", "pattern": "^WF-\\d{8}-\\d{3}$"},
    "name": {"type": "string", "minLength": 3},
    "owner": {"type": "string", "minLength": 2},
    "packet_version": {"type": "string", "pattern": "^v\\d+$"},
    "autonomy": {"enum": ["AUTONOMOUS", "SUPERVISED", "SOP_FIRST", "HUMAN_ONLY"]},
    "assessment_surface": {"type": "string", "minLength": 3},
    "execution_architecture": {"type": "string", "minLength": 10},
    "builder_surface": {"type": "string", "minLength": 3},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "handoff_status": {"enum": ["BUILD_READY", "BLOCKED_FOR_EVIDENCE", "NOT_APPLICABLE"]},
    "disposition": {"enum": ["PENDING", "APPROVE_FOR_BUILD", "HOLD_FOR_EVIDENCE", "REVISE", "REJECT"]},
    "disposition_by": {"type": "string"},
    "disposition_date": {"type": "string", "format": "date"},
    "disposition_rationale": {"type": "string"},
    "status": {
      "enum": ["SUBMITTED", "ASSESSED", "ARCHITECTURE_SELECTED", "HANDOFF_BLOCKED", "DISPOSITION_PENDING", "APPROVED_FOR_BUILD", "IN_BUILD", "VALIDATING", "ACTIVE", "PAUSED", "EXPIRED", "RECERTIFICATION_REQUIRED", "REJECTED"]
    },
    "assessed_date": {"type": "string", "format": "date"},
    "artifact_path": {"type": "string"},
    "terminal_action": {"type": "string"},
    "request_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["received_date", "source", "description_hash"],
      "properties": {
        "received_date": {"type": "string", "format": "date"},
        "source": {"type": "string", "minLength": 2},
        "description_hash": {"type": "string", "minLength": 8},
        "requestor": {"type": "string"}
      }
    },
    "architecture_options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "class", "status"],
        "properties": {
          "id": {"type": "string"},
          "class": {"enum": ["PRIMARY", "NATIVE_SUITE", "LOW_CODE", "CODE_FIRST", "VENDOR_NEUTRAL"]},
          "status": {"enum": ["GENERATED", "OMITTED", "REJECTED", "SELECTED"]},
          "reason": {"type": "string"}
        }
      }
    },
    "selected_architecture": {
      "type": "object",
      "required": ["option_id", "selected_by", "selection_date", "packet_version"],
      "properties": {
        "option_id": {"type": "string"},
        "selected_by": {"type": "string"},
        "selection_date": {"type": "string", "format": "date"},
        "packet_version": {"type": "string", "pattern": "^v\\d+$"}
      }
    },
    "builder_acknowledgement": {
      "type": "object",
      "required": ["builder", "date", "packet_version", "scope_confirmed", "controls_confirmed"],
      "properties": {
        "builder": {"type": "string"},
        "date": {"type": "string", "format": "date"},
        "packet_version": {"type": "string", "pattern": "^v\\d+$"},
        "scope_confirmed": {"type": "boolean"},
        "controls_confirmed": {"type": "boolean"},
        "evidence_path": {"type": "string"}
      }
    },
    "validation_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "criterion", "result", "evidence"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "criterion": {"type": "string"},
          "result": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "lifecycle_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "state", "actor", "packet_version"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "state": {"type": "string"},
          "actor": {"type": "string"},
          "packet_version": {"type": "string", "pattern": "^v\\d+$"},
          "evidence": {"type": "string"}
        }
      }
    },
    "expiration_triggers": {"type": "array", "items": {"type": "string"}},
    "recertification_due": {"type": "string", "format": "date"},
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "description", "resolution"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "description": {"type": "string"},
          "resolution": {"type": "string"},
          "recertification_required": {"type": "boolean"}
        }
      }
    },
    "appeals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "raised_by", "claim", "evidence", "resolution"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "raised_by": {"type": "string"},
          "claim": {"type": "string"},
          "evidence": {"type": "string"},
          "resolution": {"type": "string"},
          "new_packet_version": {"type": "string"}
        }
      }
    },
    "change_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "change", "impact", "result"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "change": {"type": "string"},
          "impact": {"type": "string"},
          "result": {"enum": ["IN_SCOPE", "OUT_OF_SCOPE", "RECERTIFICATION_REQUIRED"]}
        }
      }
    },
    "precedent_refs": {"type": "array", "items": {"type": "string"}},
    "value_metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment_minutes": {"type": "number", "minimum": 0},
        "unsafe_requests_rejected": {"type": "integer", "minimum": 0},
        "build_rework_avoided_hours": {"type": "number", "minimum": 0},
        "time_to_approved_handoff_hours": {"type": "number", "minimum": 0},
        "recertification_compliant": {"type": "boolean"}
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["packet_version", "assessed_date", "autonomy", "disposition"],
        "properties": {
          "packet_version": {"type": "string", "pattern": "^v\\d+$"},
          "assessed_date": {"type": "string", "format": "date"},
          "autonomy": {"type": "string"},
          "disposition": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "APPROVE_FOR_BUILD"}}, "required": ["disposition"]},
      "then": {"required": ["disposition_by", "disposition_date", "disposition_rationale"], "properties": {"handoff_status": {"const": "BUILD_READY"}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["ACTIVE", "PAUSED", "EXPIRED"]}}, "required": ["status"]},
      "then": {"required": ["terminal_action", "expiration_triggers", "selected_architecture", "builder_acknowledgement"], "properties": {"validation_evidence": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["ARCHITECTURE_SELECTED", "DISPOSITION_PENDING", "APPROVED_FOR_BUILD", "IN_BUILD", "VALIDATING", "ACTIVE", "PAUSED", "EXPIRED"]}}, "required": ["status"]},
      "then": {"required": ["selected_architecture"]}
    },
    {
      "if": {"properties": {"status": {"enum": ["IN_BUILD", "VALIDATING", "ACTIVE", "PAUSED", "EXPIRED"]}}, "required": ["status"]},
      "then": {"required": ["builder_acknowledgement"]}
    }
  ]
}
